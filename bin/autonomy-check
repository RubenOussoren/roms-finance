#!/usr/bin/env python3
"""Frozen, branch-bound validation. Pending records require supervised reconciliation.

Never delete a pending record merely because its launcher PID has disappeared: Docker
operations can outlive the CLI (and SIGKILL). Inspect the recorded owned container or
browser completion marker first, then reconcile its owned snapshots under the lock.
"""
import fcntl
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import shutil
import signal
import stat
import subprocess
import sys
import time
import uuid


class HarnessError(RuntimeError):
    pass


class DeferredSignals:
    """Do not forward signals or unwind while daemon work may still be running."""
    def __init__(self):
        self.number = None
        self.previous = {}

    def __enter__(self):
        for number in (signal.SIGINT, signal.SIGTERM):
            self.previous[number] = signal.signal(number, self.receive)
        return self

    def receive(self, number, _frame):
        if self.number is None:
            self.number = number

    def check(self):
        if self.number:
            raise HarnessError('Interrupted before scheduling further validation')

    def __exit__(self, *_args):
        for number, handler in self.previous.items():
            signal.signal(number, handler)


def run(args, **kwargs):
    # A terminal SIGINT must not kill the attachment while our handler defers it.
    return subprocess.run(args, check=True, start_new_session=True, **kwargs)


def output(args):
    return run(args, stdout=subprocess.PIPE, text=True).stdout.strip()


def validate_cli(args, environ):
    allowed = {'db:issue145:migrate', 'test', 'zeitwerk:check', 'db:schema:load', 'db:fixtures:load',
               'assets:precompile', 'preflight', 'docs', 'rubocop', 'brakeman', 'js-lint'}
    if not args or args[0] not in allowed:
        raise HarnessError('Usage: bin/autonomy-check {test [files...]|zeitwerk:check|assets:precompile|db:schema:load|db:fixtures:load|preflight|docs|rubocop|brakeman|js-lint}')
    if args[0] == 'db:issue145:migrate':
        if environ.get('AUTONOMY_MIGRATE_APPROVED') != 'issue-145':
            raise HarnessError('Explicit issue-145 migration execution approval required')
    elif args[0].startswith('db:') and environ.get('AUTONOMY_PREPARE_APPROVED') != 'bootstrap-2026-10':
        raise HarnessError('Explicit disposable preparation approval required')
    if args[0] not in {'test', 'rubocop'} and len(args) != 1:
        raise HarnessError('This command takes no additional arguments')
    if any(not a or a.startswith(('-', '/')) or '..' in a or ':' in a or '\\' in a
           or any(c.isspace() for c in a) for a in args[1:]):
        raise HarnessError('Only explicit relative test paths/names accepted')


ASSETS = ('app/assets/builds', 'public/assets')
NEW_ROOTS = ('app', 'bin', 'config', 'lib', 'db', 'test', 'docs', 'tooling')


def excluded(path):
    parts = PurePosixPath(path).parts
    # Checked-in browser assets are application source, not runtime installs.
    if parts and parts[0] == 'vendor' and (len(parts) < 2 or parts[1] not in {'javascript', 'assets'}):
        return True
    if any(p in {'.git', 'tmp', 'log', 'node_modules', '.bundle',
                 'bundle', 'private', '.ssh', '.aws'} for p in parts):
        return True
    for p in parts:
        lower = p.lower()
        example = lower.endswith(('.example', '.example.yml', '.sample', '.sample.yml'))
        if not example and (lower.startswith(('.env', 'dotenv', 'credentials', 'secrets'))
                            or lower in {'master.key', 'secret', 'secret.key'}):
            return True
    return False


def source_paths(root):
    def listed(args):
        return set(os.fsdecode(p) for p in run(['git', '-C', str(root), 'ls-files', '-z'] + args,
                                              stdout=subprocess.PIPE).stdout.split(b'\0') if p)
    paths = listed([]) | listed(['--others', '--exclude-standard', '--', *NEW_ROOTS])
    # Approved generated assets are intentionally allowed even when gitignored.
    for directory in ASSETS:
        base = root / directory
        if base.is_symlink() or any((root / str(p)).is_symlink()
                                    for p in PurePosixPath(directory).parents if str(p) != '.'):
            raise HarnessError('Asset directory must not traverse a symlink')
        if base.exists():
            for current, dirs, files in os.walk(base, followlinks=False):
                dirs[:] = [name for name in dirs
                           if not excluded((Path(current) / name).relative_to(root).as_posix())]
                for name in dirs + files:
                    p = Path(current) / name
                    if excluded(p.relative_to(root).as_posix()):
                        continue
                    if p.is_symlink() or p.is_file():
                        paths.add(p.relative_to(root).as_posix())
    return sorted(p for p in paths if not excluded(p))


def safe_link(root, relative, selected):
    """Resolve each hop lexically before accessing it; never dereference secrets."""
    todo = list(PurePosixPath(relative).parts)
    resolved = []
    hops = 0
    while todo:
        part = todo.pop(0)
        if part == '.':
            continue
        if part == '..':
            if not resolved:
                raise HarnessError('Symlink escapes source: ' + relative)
            resolved.pop()
            continue
        candidate = '/'.join(resolved + [part])
        if excluded(candidate):
            raise HarnessError('Symlink targets excluded path: ' + relative)
        path = root / candidate
        if path.is_symlink():
            hops += 1
            if hops > 40:
                raise HarnessError('Symlink cycle: ' + relative)
            target = os.readlink(path)
            if os.path.isabs(target):
                raise HarnessError('Absolute symlink refused: ' + relative)
            todo = list(PurePosixPath(target).parts) + todo
        else:
            resolved.append(part)
    target = '/'.join(resolved)
    if not (root / target).exists():
        raise HarnessError('Symlink target is missing: ' + relative)
    if target not in selected and not any(p.startswith(target + '/') for p in selected):
        raise HarnessError('Symlink target is not captured: ' + relative)


def freeze_source(root, destination):
    paths = source_paths(root)
    selected = set(paths)
    digest = hashlib.sha256()
    for relative in paths:
        src, dst = root / relative, destination / relative
        # A tracked path below a directory symlink must not silently escape.
        for parent in PurePosixPath(relative).parents:
            if str(parent) != '.' and (root / str(parent)).is_symlink():
                raise HarnessError('Source parent is a symlink: ' + relative)
        try:
            mode = src.lstat().st_mode
        except FileNotFoundError:  # Locally deleted tracked source is not captured.
            continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        if stat.S_ISLNK(mode):
            safe_link(root, relative, selected)
            data = os.fsencode(os.readlink(src))
            dst.symlink_to(os.fsdecode(data))
            kind = 'link'
        elif stat.S_ISREG(mode):
            # O_NOFOLLOW also closes a file -> symlink swap during capture.
            fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
            with os.fdopen(fd, 'rb') as stream:
                captured = os.fstat(stream.fileno())
                data = stream.read()
            mode = captured.st_mode
            dst.write_bytes(data)
            dst.chmod(stat.S_IMODE(mode))
            kind = 'file'
        else:
            raise HarnessError('Unsupported source file: ' + relative)
        header = json.dumps([relative, kind, stat.S_IMODE(mode), len(data)],
                            separators=(',', ':')).encode()
        digest.update(header + b'\0' + data + b'\0')
    return digest.hexdigest()


class Pending:
    def __init__(self, common, root, head):
        self.path = common / 'roms-autonomy-pending.json'
        if self.path.exists():
            raise HarnessError('Unsettled autonomy operation: supervised reconciliation required; do not reuse or automatically delete roms-autonomy-pending.json')
        self.data = {'version': 1, 'id': uuid.uuid4().hex, 'worktree': str(root),
                     'head': head, 'phase': 'capture', 'pid': os.getpid()}
        self.directory = common / ('roms-autonomy-operation-' + self.data['id'])
        self.snapshot = self.directory / 'source'
        self.data.update(directory=str(self.directory), snapshot=str(self.snapshot))
        self.save()
        self.directory.mkdir(mode=0o700)
        self.snapshot.mkdir(mode=0o700)

    def save(self, **fields):
        self.data.update(fields)
        temp = self.path.with_suffix('.new')
        with open(temp, 'w') as stream:
            json.dump(self.data, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, self.path)
        fd = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)

    def clear(self):
        shutil.rmtree(self.directory)
        self.path.unlink()


def verify_resources(root, common, branch, head, compose, resource):
    record = json.loads((common / 'roms-autonomy-resources.json').read_text())
    if not (branch == 'automation/bootstrap-2026-10' and str(root) == record['setup_worktree']):
        checkpoint = json.loads((common / 'roms-autonomy-checkpoint.json').read_text())
        if (str(root), branch, head) != (checkpoint['worktree'], checkpoint['branch'], checkpoint['head_sha']):
            raise HarnessError('Validation worktree/branch/SHA differs from checkpoint')
    redis = json.loads(output(resource + ['ps', '--format', 'json']))
    labels = dict(item.split('=', 1) for item in redis['Labels'].split(','))
    if (redis['ID'] != record['redis_id'] or redis['Name'] != 'roms-autonomy-test-redis'
            or labels.get('finance.roms.autonomy.owner') != 'bootstrap-2026-10'
            or labels.get('finance.roms.autonomy.disposable') != 'true'
            or redis['Project'] != 'roms-autonomy-resources'
            or redis['Networks'] != 'roms-finance-sandbox_default'
            or any(p['PublishedPort'] != 0 for p in (redis['Publishers'] or []))):
        raise HarnessError('Dedicated Redis identity/ownership/network/port mismatch; do not adopt')
    marker = output(compose + ['exec', '-T', 'db', 'psql', '-U', 'postgres', '-d', 'postgres', '-Atc',
                              "SELECT shobj_description(oid, 'pg_database') FROM pg_database WHERE datname='roms_autonomy_test'"])
    if marker != 'ROMS autonomy disposable bootstrap-2026-10 synthetic only':
        raise HarnessError('Disposable DB ownership not established')
    if output(resource + ['exec', '-T', 'test-redis', 'redis-cli', 'PING']) != 'PONG':
        raise HarnessError('Dedicated test Redis unavailable')


def validation_command(args, workspace, bundle, browsers, environ):
    env = ['env', '-i', 'PATH=/usr/local/bin:/usr/bin:/bin', 'HOME=/tmp',
           'BUNDLE_PATH=' + bundle, 'LANG=C.UTF-8', 'RAILS_ENV=test', 'DB_HOST=db',
           'POSTGRES_USER=postgres', 'POSTGRES_PASSWORD=postgres', 'POSTGRES_DB=roms_autonomy_test',
           'REDIS_URL=redis://roms-autonomy-test-redis:6379/0',
           'CACHE_REDIS_URL=redis://roms-autonomy-test-redis:6379/0',
           'DISABLE_PARALLELIZATION=true', 'CI=true', 'SECRET_KEY_BASE=autonomy-synthetic-only',
           'PLAYWRIGHT_BROWSERS_PATH=' + browsers,
           'RUBYOPT=-r' + workspace + '/test/tooling/autonomy_guard.rb']
    if environ.get('AUTONOMY_BROWSER_EVIDENCE') == 'true':
        env.append('AUTONOMY_BROWSER_EVIDENCE=true')
    if args[0] in {'db:schema:load', 'db:fixtures:load'}:
        env.append('AUTONOMY_PREPARE_APPROVED=bootstrap-2026-10')
    if args[0] == 'db:issue145:migrate':
        env.append('AUTONOMY_MIGRATE_APPROVED=issue-145')
    commands = {'db:issue145:migrate': ['bundle', 'exec', 'ruby', 'tooling/migrate_issue145.rb'],
                'preflight': ['bundle', 'exec', 'ruby', 'test/tooling/autonomy_preflight.rb'],
                'docs': ['bundle', 'exec', 'ruby', 'bin/check-development-docs'],
                'rubocop': ['bundle', 'exec', 'ruby', 'bin/rubocop'] + args[1:],
                'brakeman': ['bundle', 'exec', 'ruby', 'bin/brakeman', '--no-pager'],
                'js-lint': ['npm', 'run', 'lint']}
    return env + commands.get(args[0], ['bundle', 'exec', 'ruby', 'bin/rails'] + args)


def ordinary(pending, compose, docker, command, source, signals):
    name = 'roms-autonomy-check-' + pending.data['id']
    pending.save(phase='ordinary-launch', container=name)
    signals.check()
    # Compose run has no --restart flag. Override only the owned one-off's policy,
    # outside the source manifest; retained app configuration is not changed.
    override = pending.directory / 'compose.json'
    override.write_text(json.dumps({'services': {'app': {'restart': 'no'}}}))
    compose = compose + ['-f', str(override)]
    mounts = ['-v', f'{pending.snapshot}:/workspace',
              '-v', f'{source}/node_modules:/workspace/node_modules:ro',
              '-v', 'roms-finance-sandbox_bundle_cache:/bundle:ro']
    cache = source / 'tmp/roms-autonomy-browser-cache'
    if cache.exists():
        mounts += ['-v', f'{cache}:/autonomy-browsers:ro']
    signals.check()
    run(compose + ['run', '-d', '--no-deps', '-T', '--name', name,
                   '--user', f'{os.getuid()}:{os.getgid()}', '--entrypoint', 'env']
        + mounts + ['app'] + command[1:])
    pending.save(phase='ordinary-running')
    # docker wait is explicit; inspect, not the wait CLI's lifetime, proves exit.
    output(docker + ['wait', name])
    state = json.loads(output(docker + ['inspect', '--format', '{{json .State}}', name]))
    if state.get('Status') != 'exited' or state.get('Running'):
        raise HarnessError('Ordinary container exit not confirmed')
    code = int(state['ExitCode'])
    pending.save(phase='settled', exit_code=code)
    run(docker + ['logs', name])
    run(docker + ['rm', name])  # Never force removal, never touch retained services.
    return code


def browser_step(pending, compose, directory, command, step):
    marker = directory + '/.autonomy-' + step + '.exit'
    log = directory + '/.autonomy-' + step + '.log'
    pending.save(phase='browser-' + step, completion_marker=marker, operation_log=log)
    script = ('marker=$1; log=$2; shift 2; "$@" >"$log" 2>&1; code=$?; '
              'printf "%s\\n" "$code" >"$marker.new" && mv "$marker.new" "$marker"')
    run(compose + ['exec', '-d', '-T', '-w', directory, 'app', 'sh', '-c', script,
                   'autonomy', marker, log] + command)
    while True:
        # Missing marker is an expected running state, not an attachment exit code.
        status = output(compose + ['exec', '-T', 'app', 'sh', '-c',
                                   'if [ -f "$1" ]; then cat "$1"; else printf pending; fi',
                                   'autonomy', marker])
        if status != 'pending':
            if not status.isdecimal() or not 0 <= int(status) <= 255:
                raise HarnessError('Invalid browser completion marker')
            pending.save(phase='settled', exit_code=int(status))
            run(compose + ['exec', '-T', 'app', 'cat', log])
            return int(status)
        time.sleep(0.2)


def browser(pending, compose, args, environ, signals):
    directory = '/tmp/roms-autonomy-browser-' + pending.data['id']
    pending.save(phase='browser-copy', browser_snapshot=directory)
    signals.check()
    # Only our uniquely named directory is copied/removed. Source is the very same
    # local capture ordinary validation mounts, not another git/tar enumeration.
    run(compose + ['cp', '--archive', str(pending.snapshot), 'app:' + directory])
    if signals.number:
        run(compose + ['exec', '-T', 'app', 'rm', '-rf', '--', directory])
        return 128 + signals.number
    dependencies = (
        'cp -R /bundle /workspace/node_modules "$1" && '
        'find "$1/bundle" "$1/node_modules" -type l -exec sh -c '
        "'base=$1; shift; for link do target=$(readlink -f \"$link\") || exit 1; "
        'case "$target" in "$base"/*) ;; *) printf "Unsafe dependency symlink\\n"; '
        "exit 1;; esac; done' autonomy \"$1\" {} +")
    code = browser_step(pending, compose, directory,
                        ['sh', '-c', dependencies, 'autonomy', directory], 'dependencies')
    if code:
        run(compose + ['exec', '-T', 'app', 'rm', '-rf', '--', directory])
        return code
    if signals.number:
        run(compose + ['exec', '-T', 'app', 'rm', '-rf', '--', directory])
        return 128 + signals.number
    command = validation_command(args, directory, directory + '/bundle',
                                 '/tmp/roms-home/.cache/ms-playwright', environ)
    code = browser_step(pending, compose, directory, command, 'validation')
    screenshots = output(compose + ['exec', '-T', 'app', 'find', directory,
                                    '-path', '*/tmp/screenshots/*.png', '-type', 'f']).splitlines()
    for screenshot in screenshots:
        if not screenshot.startswith(directory + '/'):
            raise HarnessError('Unexpected screenshot path')
        target = Path(pending.data['worktree']) / 'tmp/screenshots' / Path(screenshot).name
        target.parent.mkdir(parents=True, exist_ok=True)
        run(compose + ['cp', '--archive', 'app:' + screenshot, str(target)])
    run(compose + ['exec', '-T', 'app', 'rm', '-rf', '--', directory])
    return code


def asset_manifest(snapshot):
    return {p.relative_to(snapshot).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
            for directory in ASSETS for p in (snapshot / directory).rglob('*')
            if p.is_file() and not p.is_symlink()}


def publish_assets(snapshot, root, before):
    # Only approved asset directories; no source, deps or arbitrary container output.
    for relative in ASSETS:
        source = snapshot / relative
        if not source.exists():
            continue
        if source.is_symlink() or (root / relative).is_symlink():
            raise HarnessError('Asset directory symlink refused')
        for current, dirs, files in os.walk(source, followlinks=False):
            for name in dirs + files:
                if (Path(current) / name).is_symlink():
                    raise HarnessError('Built asset symlink refused')
        for file in source.rglob('*'):
            if not file.is_file():
                continue
            relative_file = file.relative_to(snapshot).as_posix()
            if before.get(relative_file) == hashlib.sha256(file.read_bytes()).hexdigest():
                continue
            target = root / relative_file
            if target.is_symlink() or any(parent.is_symlink() for parent in target.parents):
                raise HarnessError('Asset destination symlink refused')
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(file, target)


def publish_issue145_schema(snapshot, root, before):
    # Explicitly approved DB-generated deliverable, never arbitrary source copyback.
    relative = Path('db/schema.rb')
    source, target = snapshot / relative, root / relative
    if source.is_symlink() or target.is_symlink() or any(p.is_symlink() for p in target.parents):
        raise HarnessError('Schema destination/source symlink refused')
    if hashlib.sha256(target.read_bytes()).hexdigest() != before:
        raise HarnessError('Schema changed during migration; do not overwrite unrelated work')
    data = source.read_bytes()
    if b'version: 2026_10_06_030003' not in data:
        raise HarnessError('Migrated schema version not verified')
    temporary = target.with_name('.schema-issue145-' + uuid.uuid4().hex)
    try:
        temporary.write_bytes(data)
        if hashlib.sha256(target.read_bytes()).hexdigest() != before:
            raise HarnessError('Schema changed before publication; do not overwrite unrelated work')
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)


def main(argv=None, environ=None):
    args = list(sys.argv[1:] if argv is None else argv)
    environ = os.environ if environ is None else environ
    pending = None
    with DeferredSignals() as signals:
        try:
            validate_cli(args, environ)  # Before lock, records, snapshots or Docker.
            root = Path(output(['git', 'rev-parse', '--show-toplevel']))
            branch = output(['git', 'branch', '--show-current'])
            if args == ['db:issue145:migrate'] and branch != 'automation/issue-145':
                raise HarnessError('Issue145 migration requires its recorded feature branch')
            if not branch or branch == 'main':
                raise HarnessError('Feature worktree required')
            head = output(['git', 'rev-parse', 'HEAD'])
            common = Path(output(['git', 'rev-parse', '--path-format=absolute', '--git-common-dir']))
            with open(common / 'roms-autonomy-test.lock', 'a') as lock:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    raise HarnessError('Another disposable test command is active')
                signals.check()
                pending = Pending(common, root, head)
                digest = freeze_source(root, pending.snapshot)
                schema_before = hashlib.sha256((pending.snapshot / 'db/schema.rb').read_bytes()).hexdigest() if args == ['db:issue145:migrate'] else None
                if schema_before and hashlib.sha256((root / 'db/schema.rb').read_bytes()).hexdigest() != schema_before:
                    raise HarnessError('Schema changed during capture; migration not launched')
                assets_before = asset_manifest(pending.snapshot) if args == ['assets:precompile'] else {}
                if signals.number:
                    pending.clear()  # Capture only; no daemon work has been launched.
                    return 128 + signals.number
                pending.save(digest=digest, phase='resource-checks')
                print(f'Validating branch={branch} sha={head} manifest_sha256={digest} source={root}; DB=roms_autonomy_test Redis=roms-autonomy-test-redis', flush=True)
                docker = ['sudo', '-n', 'docker']
                compose = docker + ['compose', '-f', str(root / 'compose.dev.yml')]
                resource = docker + ['compose', '-f', str(root / 'compose.autonomy-test.yml')]
                verify_resources(root, common, branch, head, compose, resource)
                if signals.number:
                    pending.clear()  # Resource checks have returned; no validation launched.
                    return 128 + signals.number
                if args[0] == 'test' and any(p.startswith('test/system/') for p in args[1:]):
                    code = browser(pending, compose, args, environ, signals)
                else:
                    command = validation_command(args, '/workspace', '/bundle', '/autonomy-browsers', environ)
                    code = ordinary(pending, compose, docker, command, common.parent, signals)
                if code == 0 and not signals.number and args == ['assets:precompile']:
                    publish_assets(pending.snapshot, root, assets_before)
                if args == ['db:issue145:migrate'] and code != 0:
                    raise HarnessError('Migration failed; retain settled operation for supervised DB reconciliation')
                if code == 0 and args == ['db:issue145:migrate']:
                    publish_issue145_schema(pending.snapshot, root, schema_before)
                pending.clear()
                return 128 + signals.number if signals.number else code
        except (HarnessError, OSError, subprocess.SubprocessError, ValueError, KeyError) as error:
            print(str(error), file=sys.stderr)
            if pending is not None:
                print('Pending record and owned snapshot retained; supervised reconciliation required.', file=sys.stderr)
            return 128 + signals.number if signals.number else 1


if __name__ == '__main__':
    sys.exit(main())
