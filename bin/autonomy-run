#!/usr/bin/env python3
"""Supervised one-off runner. One charged iteration per invocation; no scheduler."""
import ctypes
import datetime
import fcntl
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import time
import sys
# Adopt orphaned descendants so shutdown can reap and verify the process group.
if ctypes.CDLL(None).prctl(36, 1, 0, 0, 0) != 0:
    sys.exit('Linux child-subreaper unavailable; cannot supervise descendant lifetime')


def git(*args):
    return subprocess.check_output(['git', *args], text=True).strip()


root = Path(git('rev-parse', '--show-toplevel'))
os.chdir(root)
common = Path(git('rev-parse', '--path-format=absolute', '--git-common-dir'))
lock = open(common / 'roms-autonomy.lock', 'a')
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit('Another autonomy execution holds the lock; never unlink it')
path = common / 'roms-autonomy-checkpoint.json'
branch, sha = git('branch', '--show-current'), git('rev-parse', 'HEAD')
if branch != 'automation/issue-151':
    sys.exit('Only automation/issue-151 may run the pilot')


def save():
    state['updated_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    temp = path.with_suffix('.tmp')
    temp.write_text(json.dumps(state, indent=2) + '\n')
    temp.replace(path)


mode = sys.argv[1] if len(sys.argv) == 2 else ''
if mode == 'init':
    if path.exists():
        sys.exit('Checkpoint exists: reconcile, never reset counters')
    state = {'schema_version': 1, 'mission_issue': 151, 'status': 'initialized',
             'worktree': str(root), 'branch': branch, 'head_sha': sha,
             'iterations_started': 0, 'unsuccessful_repair_approaches': 0,
             'implementation_pr': None, 'checks': [], 'pending_external_action': None}
    save()
    sys.exit(0)
if mode != 'run' or not path.exists():
    sys.exit('Usage: bin/autonomy-run init|run; resume uses run with existing checkpoint')
state = json.loads(path.read_text())
if (state['schema_version'], state['mission_issue'], state['worktree'], state['branch'], state['head_sha']) != (1, 151, str(root), branch, sha):
    sys.exit('Checkpoint identity mismatch: supervised reconciliation required')
if state['status'] not in ('initialized', 'checkpointed') or state['pending_external_action']:
    sys.exit('Unsettled prior run/action: supervised reconciliation required')
if os.environ.get('AUTONOMY_WORKSPACE_CONFIRMED') != 'issue-151':
    sys.exit('Operator must interactively confirm the pilot workspace before headless auto mode; see docs/development/autonomy.md')
if state['iterations_started'] >= 5 or state['unsuccessful_repair_approaches'] >= 2 or state['implementation_pr']:
    sys.exit('Pilot budget exhausted or already published')
if git('status', '--porcelain'):
    sys.exit('Resume requires clean reconciled worktree; commit scoped work first')
if subprocess.call(['bin/autonomy-check', 'preflight']):
    sys.exit('Test isolation preflight failed')
state.update(status='running', iterations_started=state['iterations_started'] + 1,
             holder={'pid': os.getpid(), 'hostname': socket.gethostname(),
                     'start_identity': Path(f'/proc/{os.getpid()}/stat').read_text().split()[21]})
save()
result = root / 'tmp/autonomy-result.json'
if result.exists():
    sys.exit('Prior outcome exists: reconcile instead of replacing')
child = None
stopping = False


def stop(signum, _frame):
    global stopping
    stopping = True
    if child is not None and child.poll() is None:
        os.killpg(child.pid, signal.SIGTERM)


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
prompt = Path('.term-llm/pilot-prompt.md').read_text() + '\nVerified parent checkpoint snapshot: ' + json.dumps(state) + '\nVerified resource identity: ' + (common / 'roms-autonomy-resources.json').read_text() + '\nParent flock held; isolation preflight passed. Charged iteration: ' + str(state['iterations_started']) + '. Do not publish or commit: supervisor owns publication. At outcome write tmp/autonomy-result.json with status, unsuccessful_repair_approaches (this iteration), summary and checks. Stop immediately at two cumulative failed approaches. Current prior failures=' + str(state['unsuccessful_repair_approaches']) + '. Do not repeat an unsuccessful approach. Implementation and review requests belong to supervisor.'
def settle_group():
    # Keep the common lock while any descendant remains. Never force-kill.
    try:
        os.killpg(child.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    while True:
        try:
            while os.waitpid(-child.pid, os.WNOHANG)[0]:
                pass
        except ChildProcessError:
            pass
        try:
            os.killpg(child.pid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.2)


try:
    if stopping:
        state.update(status='needs-reconciliation', stop_reason='signal before launch', child_exit=130)
        save()
        sys.exit(130)
    child = subprocess.Popen(['term-llm', '--no-session', 'loop', '--agent', './.term-llm/agents/autonomy-pilot', '--approval', 'auto', '--read-dir', str(root), '--write-dir', str(root), '--max', '1', '--done-file', 'tmp/autonomy-result.json:status', '--max-turns', '100', prompt], start_new_session=True)
    if stopping and child.poll() is None:
        os.killpg(child.pid, signal.SIGTERM)
    code = child.wait()
    settle_group()
    state['child_exit'] = code
    if result.exists():
        outcome = json.loads(result.read_text())
        failures = outcome['unsuccessful_repair_approaches']
        if not isinstance(failures, int) or failures < 0:
            raise ValueError('Invalid repair counter')
        state['unsuccessful_repair_approaches'] += failures
        state['outcome'] = outcome
        state['status'] = 'checkpointed' if code == 0 and not stopping and outcome.get('status') == 'complete' else 'needs-reconciliation'
    else:
        state['status'] = 'needs-reconciliation'
    state['stop_reason'] = 'signal' if stopping else 'one-off iteration finished'
finally:
    if child is not None and child.poll() is None:
        os.killpg(child.pid, signal.SIGTERM)
        child.wait()
    if child is not None:
        settle_group()
    state['head_sha'] = git('rev-parse', 'HEAD')
    save()
sys.exit(code)
